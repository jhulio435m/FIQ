# Copy to .env on each node. Do not commit real .env files.

# Node identity. Use one of:
# - oti: NODE_ID=1, ETCD_NAME=etcd-1, PATRONI_NAME=oti, NODE_IP=100.79.244.99
# - abc: NODE_ID=2, ETCD_NAME=etcd-2, PATRONI_NAME=abc, NODE_IP=100.97.171.89
# - server: NODE_ID=3, ETCD_NAME=etcd-3, PATRONI_NAME=server, NODE_IP=100.87.33.2
# - arch: NODE_ID=4, ETCD_NAME=etcd-4, PATRONI_NAME=arch, NODE_IP=100.110.204.72
# - debian: NODE_ID=5, ETCD_NAME=etcd-5, PATRONI_NAME=debian, NODE_IP=100.94.200.89
NODE_ID=1
NODE_IP=100.79.244.99
ETCD_NAME=etcd-1
PATRONI_NAME=oti

# Cluster node addresses over Tailscale.
NODE1_IP=100.79.244.99
NODE2_IP=100.97.171.89
NODE3_IP=100.87.33.2
NODE4_IP=100.110.204.72
NODE5_IP=100.94.200.89

ETCD_INITIAL_CLUSTER_TOKEN=fiq-etcd-cluster
ETCD_INITIAL_CLUSTER=etcd-1=http://100.79.244.99:2380,etcd-2=http://100.97.171.89:2380,etcd-3=http://100.87.33.2:2380,etcd-4=http://100.110.204.72:2380,etcd-5=http://100.94.200.89:2380
ETCD_INITIAL_CLUSTER_STATE=new
PATRONI_ETCD_HOSTS=100.79.244.99:2379,100.97.171.89:2379,100.87.33.2:2379,100.110.204.72:2379,100.94.200.89:2379

# Generate real values with:
# openssl rand -base64 32
POSTGRES_SUPERUSER_PASSWORD=replace-me
POSTGRES_REPLICATION_PASSWORD=replace-me
POSTGRES_REWIND_PASSWORD=replace-me
