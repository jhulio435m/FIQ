DATABASE_URL=postgresql://fiq:fiq123@localhost:5433/fiq_db
ENVIRONMENT=development
# Only local HTTP development. Must be true for staging/production HTTPS.
SESSION_COOKIE_SECURE=false
# Optional. In HA production point this to HAProxy read endpoint :5001.
# If empty, read-only endpoints use DATABASE_URL.
DATABASE_READ_URL=
# Production HAProxy endpoint used by docker-compose.prod.yml.
POSTGRES_HA_HOST=100.79.244.99
# Optional app-level resource sharding. Comma-separated PostgreSQL DSNs.
RESOURCE_SHARD_DATABASE_URLS=
RESOURCE_SHARD_READ_DATABASE_URLS=
RESOURCE_SHARD_ID_STRIDE=1000000000
REDIS_URL=redis://localhost:6379/0
TRUST_PROXY_HEADERS=false
MONGO_ENABLED=false
MONGO_URL=mongodb://localhost:27017
# Atlas example:
# MONGO_URL=mongodb+srv://fiq_app:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=FIQ
MONGO_DB_NAME=fiq_events
MONGO_ACTIVITY_COLLECTION=activity_events
MONGO_EXTERNAL_CACHE_COLLECTION=external_catalog_cache
# Generate at least 32 random bytes for production; never reuse this example.
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_REQUESTS=10
SESSION_RATE_LIMIT_REQUESTS=120
EXTERNAL_SEARCH_RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=fiq-recursos
S3_QUARANTINE_BUCKET_NAME=fiq-cuarentena
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
CORS_ORIGINS=["http://localhost:5173"]
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_TENANT_ID=57c17caf-c500-4ffc-9976-f85fc6c66d47
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=biblioteca@uncp.edu.pe
SMTP_STARTTLS=true
EXTERNAL_CACHE_TTL_SECONDS=86400
