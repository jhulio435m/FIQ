# Copiar a backend/.env para desarrollo local. En staging/producción
# (ENVIRONMENT=staging|production) el backend NO arranca con estos valores.
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql://fiq:fiq123@localhost:5433/fiq_db
# Obligatorio en producción (refresh tokens y rate limiting compartidos).
REDIS_URL=redis://localhost:6379/0

MONGO_ENABLED=false
MONGO_URL=mongodb://localhost:27017
# Atlas example:
# MONGO_URL=mongodb+srv://fiq_app:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=FIQ
MONGO_DB_NAME=fiq_events
MONGO_ACTIVITY_COLLECTION=activity_events
MONGO_EXTERNAL_CACHE_COLLECTION=external_catalog_cache

# Producción: openssl rand -hex 32
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
ALLOW_PUBLIC_REGISTRATION=false

# Almacenamiento S3-compatible (RustFS en desarrollo: docker compose up -d rustfs)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET_NAME=fiq-recursos

CORS_ORIGINS=["http://localhost:5173"]

MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_TENANT_ID=57c17caf-c500-4ffc-9976-f85fc6c66d47
EXTERNAL_CACHE_TTL_SECONDS=86400

# Observabilidad (opcional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
METRICS_ENABLED=true
